{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Aresta Intelligence Plugin Manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "key",
    "name",
    "category",
    "vendor",
    "auth",
    "capabilities",
    "data_policy",
    "review_required"
  ],
  "properties": {
    "schema_version": {
      "const": "1"
    },
    "key": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]{2,64}$"
    },
    "name": {
      "type": "string",
      "minLength": 3
    },
    "category": {
      "enum": [
        "content",
        "data",
        "community",
        "editor",
        "reporting",
        "crm"
      ]
    },
    "vendor": {
      "type": "string"
    },
    "auth": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "enum": [
            "none",
            "oauth2",
            "api_key_server",
            "mcp_external",
            "github_app"
          ]
        },
        "scopes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "action",
          "kind",
          "requires_approval"
        ],
        "additionalProperties": false,
        "properties": {
          "action": {
            "type": "string"
          },
          "kind": {
            "enum": [
              "read",
              "draft",
              "publish",
              "mutate",
              "execute"
            ]
          },
          "requires_approval": {
            "type": "boolean"
          }
        }
      }
    },
    "data_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "level",
        "notes"
      ],
      "properties": {
        "level": {
          "enum": [
            "public",
            "internal",
            "restricted"
          ]
        },
        "notes": {
          "type": "string"
        }
      }
    },
    "review_required": {
      "type": "boolean"
    },
    "source_contract": {
      "type": "string",
      "format": "uri"
    },
    "status": {
      "enum": [
        "catalogued",
        "planned",
        "needs_auth",
        "connected",
        "disabled"
      ]
    }
  }
}
